# IntelliJ Run Configuration
# Active profiles: local
# Working directory: gateway-service 저장소 루트
#
# 이 파일을 .env.local로 복사한 뒤 로컬 구성에 맞게 변경합니다.

SERVER_PORT=8080

# local 프로필은 Eureka 대신 각 서비스의 고정 포트로 직접 연결합니다.
IDENTITY_SERVICE_URI=http://localhost:8083
LEARNING_SERVICE_URI=http://localhost:8084
RULE_SERVICE_URI=http://localhost:8081

# Identity Access JWT 검증용 공개 계약
JWT_ISSUER=https://identity.omagotchi.local
JWT_AUDIENCE=omagotchi-api
JWT_PUBLIC_KEY_LOCATION=file:./secrets/jwt-public.pem
