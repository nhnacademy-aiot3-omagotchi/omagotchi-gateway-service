@cohortId = 1

### 공간 목록 조회
# @name getSpaces
# @no-log
GET {{baseUrl}}/api/v1/spaces
Authorization: Bearer {{accessToken}}
Accept: application/json

> {%
    client.test("공간 목록 조회 성공", function () {
        client.assert(response.status === 200, "예상 Status: 200");
        client.assert(Array.isArray(response.body), "공간 목록 배열 누락");
    });
%}

### 내 기수 접근 컨텍스트 조회
# @name getMyCohortAccessContext
# @no-log
GET {{baseUrl}}/api/v1/cohorts/me/access-context
Authorization: Bearer {{accessToken}}
Accept: application/json

> {%
    client.test("기수 접근 컨텍스트 조회 성공", function () {
        client.assert(response.status === 200, "예상 Status: 200");
        client.assert(response.body.globalRole, "globalRole 누락");
        client.assert(Array.isArray(response.body.managedCohorts), "managedCohorts 배열 누락");
        client.assert(Array.isArray(response.body.studentCohorts), "studentCohorts 배열 누락");
    });
%}

### 시스템 관리자 기수 요약 조회
# @name getCohortAdminSummary
# @no-log
GET {{baseUrl}}/api/v1/cohorts/admin-summary
Authorization: Bearer {{accessToken}}
Accept: application/json

> {%
    client.test("시스템 관리자 기수 요약 조회 성공", function () {
        client.assert(response.status === 200, "예상 Status: 200");
        client.assert(Array.isArray(response.body), "기수 요약 배열 누락");
    });
%}

### 현재 학습 타이머 조회
# @name getCurrentTimer
# @no-log
GET {{baseUrl}}/api/v1/cohorts/{{cohortId}}/timer
Authorization: Bearer {{accessToken}}
Accept: application/json

> {%
    client.test("현재 타이머 조회 성공", function () {
        client.assert(response.status === 200, "예상 Status: 200");
        client.assert(response.body.state, "state 누락");
        client.assert(typeof response.body.elapsedSeconds === "number", "elapsedSeconds 누락");
    });
%}

### 내 회의실 점유 상태 조회
# @name getMyOccupancy
# @no-log
GET {{baseUrl}}/api/v1/occupancies/me
Authorization: Bearer {{accessToken}}
Accept: application/json

> {%
    client.test("내 회의실 점유 상태 조회 성공", function () {
        client.assert(response.status === 200, "예상 Status: 200");
        client.assert(typeof response.body.inMeeting === "boolean", "inMeeting 누락");
    });
%}

### 내 사용자 프로필 조회
# @name getMyLearningProfile
# @no-log
GET {{baseUrl}}/api/v1/user-profiles/me/profile
Authorization: Bearer {{accessToken}}
Accept: application/json

> {%
    client.test("Learning 사용자 프로필 조회 성공", function () {
        client.assert(response.status === 200, "예상 Status: 200");
        client.assert(
            typeof response.body.totalStudySeconds === "number",
            "totalStudySeconds 누락"
        );
    });
%}

### Telegram 연동 상태 조회
# 미연동 사용자는 도메인 계약에 따라 404일 수 있으므로 기본 Smoke에는 포함하지 않는다.
# @name getMyTelegramLink
# @no-log
GET {{baseUrl}}/api/v1/telegram/link
Authorization: Bearer {{accessToken}}
Accept: application/json

> {%
    client.test("Telegram 연동 상태 응답 확인", function () {
        client.assert(
            response.status === 200 || response.status === 404,
            "예상 Status: 200 또는 404"
        );
    });
%}
